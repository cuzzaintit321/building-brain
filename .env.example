# Set a long, unique admin password and a random secret before deployment.
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD
SECRET_KEY=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET
COOKIE_SECURE=false
# Optional: enables cited AI synthesis. Without it, sourced excerpts still work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Private single-workspace billing pilot only; leave disabled for public SaaS.
BILLING_PILOT_ENABLED=false
BILLING_PUBLIC_URL=
STRIPE_SECRET_KEY=
STRIPE_PORTAL_CONFIGURATION=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=
