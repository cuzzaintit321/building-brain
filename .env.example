# REQUIRED. Choose a unique, long password; never commit your real .env.
APP_PASSWORD=replace-with-long-random-password
APP_USER=admin
# Leave AI off for citation-backed document search, no API or model needed.
AI_PROVIDER=none
# Optional: AI_PROVIDER=ollama with a model running on the Docker host
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
# Optional: AI_PROVIDER=openai (property excerpts will be transmitted to that API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
